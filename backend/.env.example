# Backend environment overrides (optional)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=aetherpass
DB_USER=aetherpass
DB_PASSWORD=aetherpass

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=aetherpass
RABBITMQ_PASSWORD=aetherpass

JWT_SECRET=change-this-to-a-very-long-secure-secret-key-at-least-256-bits
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
SERVER_PORT=8080
# Render sets PORT automatically; Spring reads PORT or SERVER_PORT
JPA_DDL_AUTO=validate

# Payments: MOCK (default) or RAZORPAY
PAYMENTS_PROVIDER=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
